const root=document.getElementById('sentences');
const originalAudio=document.getElementById('fullAudio');
const sentenceRanges=[[0.12,4.16],[4.37,9.11],[9.93,14.18],[14.70,18.73],[19.37,24.85],[25.41,32.40]];
let segmentStopHandler=null;
let segmentRequest=0;

function stopOriginalAudio(){
  segmentRequest++;
  if(segmentStopHandler){originalAudio.removeEventListener('timeupdate',segmentStopHandler);segmentStopHandler=null;}
  originalAudio.pause();
}
async function playOriginalSegment(index){
  stopSpeech();stopOriginalAudio();
  const requestId=segmentRequest, range=sentenceRanges[index];
  try{
    if(originalAudio.readyState<1) await new Promise(resolve=>originalAudio.addEventListener('loadedmetadata',resolve,{once:true}));
    if(requestId!==segmentRequest)return;
    if(Math.abs(originalAudio.currentTime-range[0])>0.03 || originalAudio.seeking){
      await new Promise((resolve,reject)=>{
        const onSeeked=()=>{cleanup();resolve();}, onError=()=>{cleanup();reject(new Error('Không thể tua đến đoạn âm thanh'));};
        const cleanup=()=>{originalAudio.removeEventListener('seeked',onSeeked);originalAudio.removeEventListener('error',onError);};
        originalAudio.addEventListener('seeked',onSeeked,{once:true});originalAudio.addEventListener('error',onError,{once:true});
        originalAudio.currentTime=range[0];
      });
    }
    if(requestId!==segmentRequest)return;
    segmentStopHandler=()=>{if(originalAudio.currentTime>=range[1]-0.04){originalAudio.pause();originalAudio.removeEventListener('timeupdate',segmentStopHandler);segmentStopHandler=null;}};
    originalAudio.addEventListener('timeupdate',segmentStopHandler);
    await originalAudio.play();
  }catch(error){console.warn('Không thể phát đoạn âm thanh:',error);}
}
function stopSpeech(){if('speechSynthesis'in window)speechSynthesis.cancel();}
function voiceUS(){
  const vs=speechSynthesis.getVoices();
  return vs.find(v=>v.lang&&v.lang.toLowerCase()==='en-us') ||
         vs.find(v=>v.lang&&v.lang.toLowerCase().startsWith('en-us')) ||
         vs.find(v=>v.lang&&v.lang.toLowerCase().startsWith('en-')) || null;
}
function speak(text,rate=0.82){
  if(!('speechSynthesis'in window)){alert('Trình duyệt không hỗ trợ phát âm.');return false;}
  stopSpeech();
  const u=new SpeechSynthesisUtterance(text);u.lang='en-US';u.rate=rate;u.pitch=1;
  const v=voiceUS();if(v)u.voice=v;
  speechSynthesis.speak(u);return true;
}
