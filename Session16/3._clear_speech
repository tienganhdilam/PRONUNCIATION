er": "người nói.", "communicate": "giao tiếp; truyền đạt.", "clearly": "một cách rõ ràng.", "in": "trong; bằng.", "English": "tiếng Anh."};
const phraseData={"0": [{"words": ["young", "children"], "text": "young children", "ipa": "/jʌŋ ˈtʃɪl.drən/", "meaning": "trẻ nhỏ; những đứa trẻ còn nhỏ tuổi."}, {"words": ["the", "sounds"], "text": "the sounds", "ipa": "/ðə saʊndz/", "meaning": "những âm thanh đó."}, {"words": ["the", "language"], "text": "the language", "ipa": "/ðə ˈlæŋ.ɡwɪdʒ/", "meaning": "ngôn ngữ đó; thứ ngôn ngữ đang được nhắc đến."}], "1": [{"words": ["sound", "combinations"], "text": "sound combinations", "ipa": "/saʊnd ˌkɑːm.bəˈneɪ.ʃənz/", "meaning": "các tổ hợp âm thanh; những chuỗi âm được kết hợp với nhau."}, {"words": ["without", "effort"], "text": "without effort", "ipa": "/wɪˈðaʊt ˈef.ɚt/", "meaning": "một cách dễ dàng; không cần cố gắng."}], "2": [{"words": ["adult", "learners"], "text": "adult learners", "ipa": "/əˈdʌlt ˈlɝː.nɚz/", "meaning": "người học trưởng thành; những người lớn đang học."}, {"words": ["a", "new", "language"], "text": "a new language", "ipa": "/ə nuː ˈlæŋ.ɡwɪdʒ/", "meaning": "một ngôn ngữ mới."}], "3": [{"words": ["a", "few", "things"], "text": "a few things", "ipa": "/ə fjuː θɪŋz/", "meaning": "một vài điều; một số điều."}, {"words": ["clear", "speech"], "text": "clear speech", "ipa": "/klɪr spiːtʃ/", "meaning": "lời nói rõ ràng; cách nói dễ nghe, dễ hiểu."}], "4": [{"words": ["good", "instruction"], "text": "good instruction", "ipa": "/ɡʊd ɪnˈstrʌk.ʃən/", "meaning": "sự hướng dẫn tốt; phương pháp giảng dạy/hướng dẫn hiệu quả."}, {"words": ["your", "pronunciation"], "text": "your pronunciation", "ipa": "/jʊr prəˌnʌn.siˈeɪ.ʃən/", "meaning": "cách phát âm của bạn."}], "5": [{"words": ["your", "accent"], "text": "your accent", "ipa": "/jʊr ˈæk.sent/", "meaning": "giọng nói/giọng địa phương của bạn."}, {"words": ["a", "native", "speaker"], "text": "a native speaker", "ipa": "/ə ˈneɪ.t̬ɪv ˈspiː.kɚ/", "meaning": "một người nói tiếng Anh bản ngữ."}, {"words": ["in", "English"], "text": "in English", "ipa": "/ɪn ˈɪŋ.ɡlɪʃ/", "meaning": "bằng tiếng Anh; trong tiếng Anh."