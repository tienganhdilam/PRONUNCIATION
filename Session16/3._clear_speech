function renderSelection(info,buttons,displayText,ipa,meaning){
  document.querySelectorAll('.word.selected').forEach(x=>x.classList.remove('selected'));
  (Array.isArray(buttons)?buttons:[buttons]).forEach(button=>button.classList.add('selected'));
  stopOriginalAudio();
  speak(displayText,0.82);
  info.innerHTML='';
  const label=document.createElement('div');label.className='label';label.textContent='LISTEN · IPA · MEANING';
  const strong=document.createElement('strong');strong.textContent=displayText;
  const audio=document.createElement('div');audio.className='audio-state';audio.textContent='🔊 Đang phát phát âm…';
  const transcription=document.createElement('div');transcription.className='ipa';transcription.textContent=ipa||'Chưa có phiên âm';
  const meaningEl=document.createElement('p');meaningEl.className='meaning';meaningEl.textContent=meaning||'Chưa bổ sung nghĩa tiếng Việt.';
  info.append(label,strong,audio,transcription,meaningEl);
}
data.forEach((sentence,si)=>{
  const card=document.createElement('section');card.className='card';
  const head=document.createElement('div');head.className='cardhead';
  const h=document.createElement('h2');h.textContent=`Sentence ${si+1}`;
  const controls=document.createElement('div');
  const play=document.createElement('button');play.className='play';play.textContent='▶ Listen to sentence';play.onclick=()=>playOriginalSegment(si);
  const stop=document.createElement('button');stop.className='stop';stop.textContent='■ Stop';stop.onclick=()=>{stopSpeech();stopOriginalAudio();};
  controls.append(play,stop);head.append(h,controls);
  const line=document.createElement('div');line.className='sentence';
  const info=document.createElement('div');info.className='explain';
  const initialLabel=document.createElement('div');initialLabel.className='label';initialLabel.textContent='LISTEN · IPA · MEANING';
  const initialStrong=document.createElement('strong');initialStrong.textContent='Chọn một từ hoặc cụm từ trong câu';
  const initialText=document.createElement('p');initialText.textContent='Âm thanh sẽ phát ngay khi bạn nhấp. Với từ thuộc một cụm, nhấp vào bất kỳ từ nào cũng sẽ nghe và xem thông tin của cả cụm.';
  info.append(initialLabel,initialStrong,initialText);

  const words=sentence.words.map(item=>item[0]);
  const groups=phraseData[si]||[];
  // Map chunks by their exact word positions, not by word spelling.
  // This prevents repeated words (e.g. the) from joining the wrong chunk.
  const groupAtIndex=new Map();
  groups.forEach(group=>{
    const size=group.words.length;
    for(let start=0;start<=words.length-size;start++){
      const matches=group.words.every((w,k)=>words[start+k].toLowerCase()===w.toLowerCase());
      if(matches){
        for(let k=0;k<size;k++) groupAtIndex.set(start+k,group);
        break;
      }
    }
  });
  const groupButtons=new Map();
  words.forEach((word,wi)=>{
    const group=groupAtIndex.get(wi);
    const displayText=group ? group.text : word;
    const ipa=group ? group.ipa : (ipaMap[word]||'');
    const meaning=group ? group.meaning : (meanings[word]||'Nghĩa tiếng Việt tùy thuộc vào ngữ cảnh câu.');
    const b=document.createElement('button');
    b.className='word';
    b.textContent=word;
    b.title=group ? `Nhấp để nghe và xem cả cụm: ${group.text}` : 'Nhấp để nghe phát âm, xem IPA và nghĩa';
    b.setAttribute('aria-label',group ? group.text : word);
    if(group){
      if(!groupButtons.has(group)) groupButtons.set(group,[]);
      groupButtons.get(group).push(b);
    }
    b.onclick=()=>renderSelection(info,group ? groupButtons.get(group) : [b],displayText,ipa,meaning);
    line.appendChild(b);
    if(wi<words.length-1)line.appendChild(document.createTextNode(' '));
  });
  card.append(head,line,info);root.appendChild(card);
});
